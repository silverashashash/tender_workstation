# 服务端口
PORT=3001

# 数据持久化目录（本地默认 ./server/data 与 ./server/uploads）
# Mac mini 与 MacBook 过渡期同步可将此路径指向 iCloud Drive 目录，例如：
# DATA_DIR=/Users/你的用户名/Library/Mobile Documents/com~apple~CloudDocs/tender-workstation-data
DATA_DIR=

# 公网访问保护配置
# 本地开发设为 false 可免密直进；部署到公网个人网站时务必设为 true
AUTH_ENABLED=false
# 登录密码（公网部署时请修改为强密码）
AUTH_PASSWORD=change-me-to-a-strong-password
# 会话签名密钥（公网部署时请替换为随机长字符串）
AUTH_SECRET=replace-with-random-64-char-hex-secret

# 可选：定标文书默认机构与联系方式（避免在源码中硬编码真实信息）
DEFAULT_AGENCY_NAME=XX工程咨询有限公司招标代理机构
DEFAULT_OBJECTION_PHONE=000-00000000
DEFAULT_BID_LOCATION=评标基地
